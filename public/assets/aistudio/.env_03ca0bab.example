# Lenscribe Environment Configuration
# Copy this file to .env and fill in your values.

# Application
BRAND_NAME=Lenscribe
CONTACT_EMAIL=contact@example.com
PUBLIC_BASE_URL=https://lenscribe.example.com
HOST=127.0.0.1
PORT=8000

# Ollama (local vision model) - optional
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=180
OLLAMA_CONNECT_TIMEOUT=5

# Windows OCR
ENABLE_WINDOWS_OCR=true
WINDOWS_OCR_TIMEOUT=45

# Google Gemini (cloud vision) - optional
GEMINI_API_KEY=AIzaSyAhZjXDR6ITmK8f6x77EUiQqJkjHnIcElU
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=120

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
WAITLIST_RATE_LIMIT=5

# Upload limits
MAX_UPLOAD_BYTES=12582912t
MAX_PROMPT_CHARS=2000
MAX_IMAGE_SIDE=2400

# Model tuning
TEMPERATURE=0.0
NUM_CTX=8192

# Data directory (for waitlist SQLite)
DATA_DIR=data

# Admin
ADMIN_TOKEN=
