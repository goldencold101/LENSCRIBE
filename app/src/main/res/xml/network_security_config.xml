<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all unencrypted HTTP traffic app-wide to protect document data against MITM downgrade attacks -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
